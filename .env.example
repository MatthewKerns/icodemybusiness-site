# ===========================================
# iCodeMyBusiness Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# --- Clerk Authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# --- Convex ---
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=prod:...

# --- Owner (gates /admin/* — the operator-only dashboard) ---
# Access is derived from the VERIFIED Clerk identity, never from a database role
# column. Set these in BOTH places:
#   1) The Next.js runtime (this file / .env.build on the VPS) — powers the
#      middleware gate on /admin/*.
#   2) The Convex deployment env (separate!) — powers `requireOwner` on every
#      objectives query/mutation, so the gate holds even if middleware is bypassed:
#        npx convex env set OWNER_EMAIL_DOMAINS icodemybusiness.com
#
# TWO CLERK DASHBOARD SETTINGS ARE REQUIRED (both, they are different screens):
#   a) JWT Templates -> the template named "convex" -> Claims, add:
#        {"email": "{{user.primary_email_address}}",
#         "email_verified": "{{user.primary_email_address_verified}}"}
#      Without this, Convex's identity has no email and requireOwner fails closed.
#   b) Sessions -> "Customize session token", add:
#        {"email": "{{user.primary_email_address}}"}
#      Without this, middleware falls back to a (cached) Clerk API lookup per user.
# After changing either, sign out and back in — existing tokens are not updated.
OWNER_EMAIL_DOMAINS=icodemybusiness.com
OWNER_EMAILS=                     # Optional exact-address allowlist, comma-separated
OWNER_CLERK_USER_IDS=             # Fallback allowlist, checked FIRST so a missing
                                  # JWT claim can never lock you out. Comma-separated.

# --- Admin (legacy) ---
# Only still read by convex/emails.ts for the notification address. The former
# NEXT_PUBLIC_ADMIN_CLERK_USER_ID bootstrap has been REMOVED: it let the browser
# self-assign role:"admin" through the public createUser mutation. Use
# OWNER_CLERK_USER_IDS above instead.
ADMIN_CLERK_USER_ID=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Paid-tool prices (create these products/prices in Stripe, then paste the IDs).
STRIPE_PRICE_ID_PERSONAL=price_...     # Personal Time Planner — $24.99/mo
STRIPE_PRICE_ID_CONTRACTOR=price_...   # Side Gig / Contractor Work Time — $24.99/mo
STRIPE_PRICE_ID_BUSINESS=price_...     # Business Management (EOS) — $49.99/mo (coming soon)

# --- Resend (Email) ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@icodemybusiness.com

# --- PostHog (Analytics) ---
# Client API key (public) for PostHog project 206048 — EU cloud.
NEXT_PUBLIC_POSTHOG_KEY=phc_...
# Leave as /ingest to route ingestion through the same-origin reverse proxy
# (next.config.js rewrites -> eu.i.posthog.com), which dodges ad blockers.
# Set to https://eu.i.posthog.com to send directly and bypass the proxy.
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# --- Sentry (Error Tracking) ---
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=your-org
SENTRY_PROJECT=icodemybusiness-site

# --- Calendly ---
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/12kernsmatthew/new-meeting
# Free 15-minute intro call event type (used on /book). Falls back to NEXT_PUBLIC_CALENDLY_URL if unset.
NEXT_PUBLIC_CALENDLY_INTRO_URL=https://calendly.com/12kernsmatthew/new-meeting

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://icodemybusiness.com
# Host that actually runs the app (used for the welcome-email CTA into the
# public /free-tools page). Until the apex DNS cutover the app lives at
# staging.icodemybusiness.com; set to https://icodemybusiness.com after cutover.
NEXT_PUBLIC_APP_URL=https://staging.icodemybusiness.com

# --- Testimonials (DRAFT) ---
# The /testimonials page is an internal North-Star draft. It 404s in production
# builds unless this is explicitly set to "true". Leave UNSET for staging/prod
# so the draft stays off the live site.
# NEXT_PUBLIC_ENABLE_TESTIMONIALS_DRAFT=true

# --- Anthropic (Claude API — Top 3 Issues + E-commerce intake agents) ---
# NEEDS TO BE SET IN TWO PLACES:
#  1) The Next.js runtime (this var) — powers the streaming chat routes
#     (/api/agent/*). In prod this means /opt/icodemybusiness-site/.env.build on
#     the VPS, which deploy.sh passes to the container via --env-file. Missing it
#     here = chat routes return 500 "ANTHROPIC_API_KEY not configured".
#  2) The Convex deployment env (separate!) — powers BACKGROUND drafting
#     (intakeProcessor.ts: free-value deliverable + internal proposal). Set once
#     with:  npx convex env set ANTHROPIC_API_KEY <key>   (persists on the
#     deployment across redeploys). Missing it = background drafting falls back
#     to generic content (the flow still works; quality is lower).
ANTHROPIC_API_KEY=sk-ant-...

# --- Mango (objectives dashboard time data) ---
# CONVEX DEPLOYMENT ONLY — deliberately not NEXT_PUBLIC_*, so the key never
# reaches a browser. Read-only sync plus one confirm-first write; the objectives
# dashboard is fully usable without any of this, showing "Mango: not connected".
#   npx convex env set MANGO_MCP_TOKEN mps_...
#   npx convex env set MANGO_MCP_URL https://mango.icodemybusiness.com/mcp
#   npx convex env set MANGO_OVERHEAD_KEY icmb-overhead
# MANGO_MCP_TOKEN     Your Mango API key, the same mps_... one from /connect/mango.
# MANGO_MCP_URL       Optional; defaults to https://mango.icodemybusiness.com/mcp
# MANGO_OVERHEAD_KEY  Mango focus-project key for iCMB overhead. Find it by
#                     calling get_focus_projects; can also be set in the
#                     dashboard's owner settings.

# --- Retell AI (Voice/Chat Agent) ---
# Required for the "Talk to Alex" widget. Missing RETELL_API_KEY/RETELL_AGENT_ID
# makes /api/retell/create-call return 500 -> "Failed to start voice call".
# In prod these go in /opt/icodemybusiness-site/.env.build on the VPS; the two
# NEXT_PUBLIC_* vars must ALSO be passed as --build-arg (Dockerfile bakes them
# into the bundle at build time).
RETELL_API_KEY=...                    # Server-side API key (also used for webhook HMAC verification)
RETELL_AGENT_ID=...                   # Agent ID (server-side, for creating web calls)
NEXT_PUBLIC_RETELL_AGENT_ID=...       # Same agent ID, public prefix for client components
NEXT_PUBLIC_RETELL_PUBLIC_KEY=...     # Public key for chat widget script tag embed
# ADMIN_NOTIFICATION_EMAIL=matt@icodemybusiness.com
